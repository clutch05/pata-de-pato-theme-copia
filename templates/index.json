    "faq": {
      "type": "store-faq",
      "blocks": {
        "talla": {
          "type": "faq_item",
          "settings": {
            "question": "¿Qué talla son?",
            "answer": "<p>Son unitalla y unisex: quedan del <strong>25 al 28.5 cm</strong> (del 4 al 8 mx de dama y del 5.5 al 9.5 de caballero). Por eso son fáciles de regalar: no necesitas saber su número.</p>"
          }
        },
        "material": {
          "type": "faq_item",
          "settings": {
            "question": "¿De qué están hechas?",
            "answer": "<p>De hilo de bambú en alto porcentaje. Es lo que las hace suaves, frescas y transpirables — y lo que hace que no se sientan como unas calcetas cualquiera.</p>"
          }
        },
        "deporte": {
          "type": "faq_item",
          "settings": {
            "question": "¿Sirven para hacer deporte?",
            "answer": "<p>Sí. El bambú transpira, así que aguantan bien una tarde de cancha. Los diseños de futbol, pádel y golf nacieron justo para eso.</p>"
          }
        },
        "lavado": {
          "type": "faq_item",
          "settings": {
            "question": "¿Cómo las lavo para que duren?",
            "answer": "<p>Agua fría, del revés y sin secadora. Es todo: el bambú aguanta bien si no lo cueces.</p>"
          }
        },
        "unisex": {
          "type": "faq_item",
          "settings": {
            "question": "¿Son para hombre o para mujer?",
            "answer": "<p>Para los dos. Son unisex y unitalla — de las pocas cosas que puedes regalar sin averiguar nada antes.</p>"
          }
        },
        "envio": {
          "type": "faq_item",
          "settings": {
            "question": "¿El envío es gratis?",
            "answer": "<p>Sí, en pedidos desde $999 a toda la República.</p>"
          }
        }
      },
      "block_order": [
        "talla",
        "material",
        "deporte",
        "lavado",
        "unisex",
        "envio"
      ],
